# Copy to .env and fill in. Secrets (SMTP_*) live in the private secrets repo
# under paytm/ — never commit real values.
DATABASE_URL="file:./dev.db"

STORE_NAME="My Kirana Store"
STORE_UPI_VPA="mystore@paytm"
STORE_OWNER_EMAIL="owner@example.com"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Kirana Recon <no-reply@kirana.local>"

ENABLE_EOD_CRON="false"

# Sarvam AI speech-to-text key (voice invoice entry). Get from secrets repo.
SARVAM_API_KEY=""
