// Paytm Recon for Kirana stores — data model.
// SQLite for zero-setup local dev. To move to Postgres: change provider to
// "postgresql" and set DATABASE_URL to a Postgres connection string. The rest
// of the schema is portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The single store this instance serves (no auth / multi-tenancy in v1).
model Store {
  id         String    @id @default(cuid())
  name       String
  upiVpa     String // store's UPI VPA, e.g. kirana@paytm — used to build deeplinks
  ownerEmail String // EOD report recipient
  createdAt  DateTime  @default(now())
  invoices   Invoice[]
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIAL
}

// An invoice / lending entry generated by the Kirana store for a customer.
// reconId is the unique token embedded in the UPI deeplink + dynamic QR, and is
// what comes back in the settlement CSV's reference column to enable auto-match.
model Invoice {
  id           String        @id @default(cuid())
  reconId      String        @unique // embedded in upi:// tr & tn
  amount       Float
  customerName String?
  note         String?
  isCredit     Boolean       @default(false) // udhaar: goods given, payment expected later
  status       InvoiceStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  storeId  String
  store    Store     @relation(fields: [storeId], references: [id])
  payments Payment[]
  links    Link[]

  @@index([createdAt])
}

enum SourceApp {
  PAYTM
  GPAY
  PHONEPE
  OTHER
}

enum MatchStatus {
  MATCHED // reconId resolves AND amount matches
  MISMATCH // reconId resolves but amount differs
  UNMATCHED // no reconId, or reconId unknown
}

// A UPI payment row imported from a settlement CSV.
// externalId (UTR/RRN) is unique → idempotent imports + duplicate detection.
model Payment {
  id          String      @id @default(cuid())
  externalId  String      @unique // UTR / RRN / bank txn id
  txnRef      String? // reference field from CSV (should carry the reconId)
  amount      Float
  paidAt      DateTime
  payerVpa    String?
  sourceApp   SourceApp   @default(OTHER)
  matchStatus MatchStatus @default(UNMATCHED)
  importedAt  DateTime    @default(now())

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  links     Link[]

  @@index([paidAt])
  @@index([matchStatus])
}

// Audit record of how a payment got paired to an invoice (auto or manual).
model Link {
  id             String   @id @default(cuid())
  paymentId      String
  invoiceId      String
  linkedManually Boolean  @default(false)
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
}

// Record of each EOD report generation/email send.
model ReportRun {
  id         String   @id @default(cuid())
  runDate    DateTime @default(now())
  totalsJson String // serialized summary used in the email
  emailedTo  String?
  sentAt     DateTime?
}
